{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [
				"dist/**",
				".slotform/**",
				"!.slotform/types/**",
				"!.slotform/node_modules/**"
			]
		},
		"generate": {
			"dependsOn": ["^build"],
			"outputs": [
				".slotform/**",
				"!.slotform/types/**",
				"!.slotform/node_modules/**"
			]
		},
		"check-types": {
			"dependsOn": ["^build", "build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		}
	}
}
