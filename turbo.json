{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [
				"dist/**",
				".stack/**",
				"!.stack/types/**",
				"!.stack/node_modules/**"
			]
		},
		"generate": {
			"dependsOn": ["^build"],
			"outputs": [".stack/**", "!.stack/types/**", "!.stack/node_modules/**"]
		},
		"check-types": {
			"dependsOn": ["^build", "build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		}
	}
}
