{
	"name": "@slotform/db",
	"version": "0.1.1",
	"description": "Database plugin for slotform: Drizzle ORM over Cloudflare D1 or a SQLite file, with schema tooling and migrations.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/slotform.git",
		"directory": "plugins/db"
	},
	"homepage": "https://github.com/fcalell/slotform/tree/master/plugins/db#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/worker/index.d.ts",
			"default": "./dist/worker/index.js"
		},
		"./runtime/sqlite": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./orm": {
			"types": "./dist/orm.d.ts",
			"default": "./dist/orm.js"
		},
		"./d1": {
			"types": "./dist/d1/client.d.ts",
			"default": "./dist/d1/client.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite/client.d.ts",
			"default": "./dist/sqlite/client.js"
		}
	},
	"files": [
		"dist",
		"src",
		"templates",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"clear": "rm -rf dist node_modules .turbo",
		"test": "node --test 'src/**/*.test.ts'"
	},
	"peerDependencies": {
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"drizzle-kit": {
			"optional": true
		}
	},
	"dependencies": {
		"@slotform/cli": "workspace:^",
		"@slotform/api": "workspace:^",
		"@slotform/cloudflare": "workspace:^",
		"@slotform/node": "workspace:^",
		"@slotform/screens": "workspace:^",
		"better-sqlite3": "^13.2.0"
	},
	"devDependencies": {
		"@slotform/typescript-config": "workspace:^",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"typescript": "^7.0.2",
		"zod": "^4.6.7"
	}
}
