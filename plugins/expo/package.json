{
	"name": "@slotform/expo",
	"version": "0.1.1",
	"description": "The Expo/React Native target for slotform: Metro config, Expo app config, the expo-router entry and EAS commands.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/slotform.git",
		"directory": "plugins/expo"
	},
	"homepage": "https://github.com/fcalell/slotform/tree/master/plugins/expo#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./version-gate": {
			"types": "./dist/worker/version-gate.d.ts",
			"default": "./dist/worker/version-gate.js"
		}
	},
	"files": [
		"dist",
		"src",
		"templates",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"clear": "rm -rf dist node_modules .turbo",
		"test": "node --test 'src/**/*.test.ts'"
	},
	"dependencies": {
		"@slotform/cli": "workspace:^",
		"@slotform/api": "workspace:^",
		"@slotform/cloudflare": "workspace:^",
		"@slotform/ui-core": "workspace:^"
	},
	"peerDependencies": {
		"expo": "~58.0.25",
		"expo-application": ">=58.0.0",
		"hono": "^4.13.19",
		"react-native": "^0.88.0",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"expo-application": {
			"optional": true
		},
		"react-native": {
			"optional": true
		}
	},
	"devDependencies": {
		"@slotform/typescript-config": "workspace:^",
		"@types/node": "^26.6.6",
		"expo": "~58.0.25",
		"expo-application": "~58.1.2",
		"hono": "^4.13.19",
		"react-native": "0.88.1",
		"typescript": "^7.0.2",
		"zod": "^4.6.7"
	}
}
