{
	"name": "@slotform/screens",
	"version": "0.1.1",
	"description": "The screens workbench for slotform web apps: every route in each query state, from typed fixtures, with no backend.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/slotform.git",
		"directory": "plugins/screens"
	},
	"homepage": "https://github.com/fcalell/slotform/tree/master/plugins/screens#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"default": "./dist/node/index.js"
		},
		"./browser": {
			"types": "./dist/node/provider.d.ts",
			"default": "./dist/node/provider.js"
		},
		"./serve": {
			"types": "./dist/serve/index.d.ts",
			"default": "./dist/serve/index.js"
		},
		"./vite": {
			"types": "./dist/node/vite-plugin.d.ts",
			"default": "./dist/node/vite-plugin.js"
		},
		"./storybook": {
			"types": "./dist/node/storybook.d.ts",
			"default": "./dist/node/storybook.js"
		},
		"./channels": "./src/ui/channels.ts",
		"./fixtures": "./src/ui/fixtures.ts",
		"./checks": "./src/ui/checks.ts",
		"./msw": "./src/ui/msw.ts",
		"./preview": "./src/ui/preview.tsx",
		"./shift": "./src/ui/shift.ts",
		"./stories": "./src/ui/stories.tsx",
		"./walk": "./src/ui/walk.ts"
	},
	"files": [
		"dist",
		"src",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"test": "node --test 'src/**/*.test.ts'",
		"check-types": "tsc --noEmit --pretty",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"peerDependencies": {
		"@orpc/client": "^1.16.2",
		"@orpc/server": "^1.16.2",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-vitest": "^10.6.7",
		"@storybook/react-vite": "^10.6.7",
		"@tanstack/react-router": "^1.170.46",
		"@vitest/browser": "^5.0.3",
		"msw": "^3.0.6",
		"msw-storybook-addon": "^3.0.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"storybook": "^10.6.7",
		"vitest": "^5.0.3"
	},
	"peerDependenciesMeta": {
		"@storybook/addon-a11y": {
			"optional": true
		},
		"@storybook/addon-vitest": {
			"optional": true
		},
		"@storybook/react-vite": {
			"optional": true
		},
		"@tanstack/react-router": {
			"optional": true
		},
		"@vitest/browser": {
			"optional": true
		},
		"msw": {
			"optional": true
		},
		"msw-storybook-addon": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"storybook": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"dependencies": {
		"@slotform/cli": "workspace:^",
		"@slotform/api": "workspace:^",
		"@slotform/query": "workspace:^",
		"@slotform/react": "workspace:^",
		"@slotform/vite": "workspace:^",
		"@slotform/ui-core": "workspace:^",
		"@orpc/standard-server-fetch": "^1.16.2",
		"ws": "^8.23.0"
	},
	"devDependencies": {
		"@slotform/typescript-config": "workspace:^",
		"@orpc/client": "^1.16.2",
		"@orpc/server": "^1.16.2",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-vitest": "^10.6.7",
		"@storybook/react-vite": "^10.6.7",
		"@tanstack/react-router": "^1.170.46",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/browser": "^5.1.0",
		"msw": "^3.0.6",
		"msw-storybook-addon": "^3.0.3",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"storybook": "^10.6.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
