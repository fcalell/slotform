{
	"name": "@slotform/vite",
	"version": "0.1.1",
	"description": "The Vite lifecycle plugin for slotform, framework-agnostic: renders .slotform/vite.config.ts from what other plugins contribute, runs vite for dev and build, and serves the providers and schema virtual modules.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/slotform.git",
		"directory": "plugins/vite"
	},
	"homepage": "https://github.com/fcalell/slotform/tree/master/plugins/vite#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./csp": {
			"types": "./dist/node/csp.d.ts",
			"default": "./dist/node/csp.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"default": "./dist/node/index.js"
		},
		"./preset": {
			"types": "./dist/node/preset.d.ts",
			"default": "./dist/node/preset.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"test": "node --test 'src/**/*.test.ts'",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"peerDependencies": {
		"vite": "^8.3.8",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"dependencies": {
		"@slotform/cli": "workspace:^",
		"@slotform/api": "workspace:^"
	},
	"devDependencies": {
		"@slotform/typescript-config": "workspace:^",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"zod": "^4.6.7"
	}
}
