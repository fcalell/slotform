{
	"name": "@fcalell/plugin-auth",
	"version": "0.1.0",
	"description": "Authentication for @fcalell/stack: Better Auth with email codes, magic links, OAuth, passkeys, organizations, roles and record abilities.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/auth"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/auth#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./ability": {
			"types": "./dist/ability/index.d.ts",
			"default": "./dist/ability/index.js"
		},
		"./runtime": {
			"types": "./dist/worker/index.d.ts",
			"default": "./dist/worker/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"default": "./dist/schema/index.js"
		},
		"./schema/organization": {
			"types": "./dist/schema/organization.d.ts",
			"default": "./dist/schema/organization.js"
		},
		"./schema/oauth": {
			"types": "./dist/schema/oauth.d.ts",
			"default": "./dist/schema/oauth.js"
		},
		"./schema/passkey": {
			"types": "./dist/schema/passkey.d.ts",
			"default": "./dist/schema/passkey.js"
		},
		"./schema/devices": {
			"types": "./dist/schema/devices.d.ts",
			"default": "./dist/schema/devices.js"
		},
		"./expo": "./src/expo.tsx",
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./scope": {
			"types": "./dist/scope.d.ts",
			"default": "./dist/scope.js"
		},
		"./access": {
			"types": "./dist/access.d.ts",
			"default": "./dist/access.js"
		},
		"./infer": {
			"types": "./dist/infer.d.ts",
			"default": "./dist/infer.js"
		},
		"./screens": {
			"types": "./dist/screens.d.ts",
			"default": "./dist/screens.js"
		},
		"./serve": {
			"types": "./dist/serve.d.ts",
			"default": "./dist/serve.js"
		},
		"./screens-fixtures": {
			"types": "./dist/screens-fixtures.d.ts",
			"default": "./dist/screens-fixtures.js"
		}
	},
	"files": [
		"dist",
		"src",
		"guide",
		"templates",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"clear": "rm -rf dist node_modules .turbo",
		"test": "node --test 'src/**/*.test.ts'"
	},
	"dependencies": {
		"@better-auth/cimd": "1.7.25",
		"@better-auth/core": "1.7.25",
		"@better-auth/expo": "1.7.25",
		"@better-auth/mcp": "1.7.25",
		"@fcalell/cli": "workspace:^",
		"@fcalell/plugin-api": "workspace:^",
		"@fcalell/plugin-cloudflare": "workspace:^",
		"@fcalell/plugin-db": "workspace:^",
		"@fcalell/plugin-screens": "workspace:^",
		"ws": "^8.23.0"
	},
	"peerDependencies": {
		"@better-auth/api-key": "1.7.25",
		"@better-auth/oauth-provider": "1.7.25",
		"@better-auth/passkey": "1.7.25",
		"@casl/ability": "^7.1.3",
		"@orpc/server": "^1.16.2",
		"@react-native-google-signin/google-signin": "^17.0.0",
		"better-auth": "1.7.25",
		"drizzle-orm": "^0.45.4",
		"expo-apple-authentication": ">=58.0.0",
		"msw": "^3.0.6",
		"react": "^19.3.0",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"@react-native-google-signin/google-signin": {
			"optional": true
		},
		"expo-apple-authentication": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"msw": {
			"optional": true
		}
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"@types/node": "^26.6.6",
		"@react-native-google-signin/google-signin": "^17.0.0",
		"@types/react": "^19.3.0",
		"expo-apple-authentication": "~58.0.3",
		"react": "19.3.0",
		"typescript": "^7.0.2",
		"zod": "^4.6.7",
		"@orpc/server": "^1.16.2",
		"@casl/ability": "^7.1.3",
		"better-auth": "1.7.25",
		"@better-auth/api-key": "1.7.25",
		"@better-auth/oauth-provider": "1.7.25",
		"@better-auth/passkey": "1.7.25",
		"drizzle-orm": "^0.45.4",
		"msw": "^3.0.6"
	}
}
