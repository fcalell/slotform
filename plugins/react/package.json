{
	"name": "@fcalell/plugin-react",
	"version": "0.1.0",
	"description": "React framework plugin for @fcalell/stack: React on Vite with the React Compiler, TanStack Router file routes and the HTML shell.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/react"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/react#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./codegen": {
			"types": "./dist/node/router-plugin.d.ts",
			"default": "./dist/node/router-plugin.js"
		},
		"./node/refresh": {
			"types": "./dist/node/refresh.d.ts",
			"default": "./dist/node/refresh.js"
		}
	},
	"files": [
		"dist",
		"src",
		"templates",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"test": "node --test 'src/**/*.test.ts'",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"peerDependencies": {
		"@tanstack/router-generator": "^1.168.0",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"@tanstack/router-generator": {
			"optional": true
		}
	},
	"dependencies": {
		"@fcalell/cli": "workspace:^",
		"@fcalell/plugin-vite": "workspace:^"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"@tanstack/router-generator": "^1.168.0",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"zod": "^4.6.7"
	}
}
