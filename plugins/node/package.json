{
	"name": "@slotform/node",
	"version": "0.1.1",
	"description": "A long-running Node server target for slotform: serves the API, the built web client and background services from one process.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/slotform.git",
		"directory": "plugins/node"
	},
	"homepage": "https://github.com/fcalell/slotform/tree/master/plugins/node#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./ws": {
			"types": "./dist/ws/index.d.ts",
			"default": "./dist/ws/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./serve": {
			"types": "./dist/serve.d.ts",
			"default": "./dist/serve.js"
		},
		"./screens": {
			"types": "./dist/screens.d.ts",
			"default": "./dist/screens.js"
		},
		"./live": {
			"types": "./dist/live/index.d.ts",
			"default": "./dist/live/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"clear": "rm -rf dist node_modules .turbo",
		"test": "node --test 'src/**/*.test.ts'"
	},
	"dependencies": {
		"@slotform/cli": "workspace:^",
		"@slotform/api": "workspace:^",
		"@slotform/query": "workspace:^",
		"@slotform/screens": "workspace:^",
		"@slotform/vite": "workspace:^",
		"@slotform/ui-core": "workspace:^",
		"@hono/node-server": "^2.1.8",
		"ws": "^8.23.0"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.107.1",
		"esbuild": "^0.28.2",
		"hono": "^4.13.19",
		"msw": "^3.0.6",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-query": {
			"optional": true
		},
		"esbuild": {
			"optional": true
		},
		"msw": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@slotform/typescript-config": "workspace:^",
		"@tanstack/react-query": "^5.107.1",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"esbuild": "^0.28.2",
		"hono": "^4.13.19",
		"msw": "^3.0.6",
		"typescript": "^7.0.2",
		"zod": "^4.6.7"
	}
}
