{
	"name": "@fcalell/plugin-api",
	"version": "0.1.0",
	"description": "API plugin for @fcalell/stack: Hono + oRPC + Zod behind a procedure builder and a typed client.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/api"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/api#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/worker/index.d.ts",
			"default": "./dist/worker/index.js"
		},
		"./procedure": {
			"types": "./dist/procedure.d.ts",
			"default": "./dist/procedure.js"
		},
		"./mcp": {
			"types": "./dist/mcp.d.ts",
			"default": "./dist/mcp.js"
		},
		"./error": {
			"types": "./dist/error.d.ts",
			"default": "./dist/error.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./wire": {
			"types": "./dist/wire.d.ts",
			"default": "./dist/wire.js"
		},
		"./query-invalidation": {
			"types": "./dist/query-invalidation.d.ts",
			"default": "./dist/query-invalidation.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./lib/cursor": {
			"types": "./dist/lib/cursor.d.ts",
			"default": "./dist/lib/cursor.js"
		},
		"./lib/window": {
			"types": "./dist/lib/window.d.ts",
			"default": "./dist/lib/window.js"
		},
		"./lib/chosen": {
			"types": "./dist/lib/chosen.d.ts",
			"default": "./dist/lib/chosen.js"
		},
		"./lib/slugify": {
			"types": "./dist/lib/slugify.d.ts",
			"default": "./dist/lib/slugify.js"
		},
		"./local-origin": {
			"types": "./dist/lib/local-origin.d.ts",
			"default": "./dist/lib/local-origin.js"
		}
	},
	"files": [
		"dist",
		"src",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"test": "node --test 'src/**/*.test.ts'",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"dependencies": {
		"@fcalell/cli": "workspace:^",
		"@modelcontextprotocol/server": "2.4.0",
		"@orpc/client": "^1.16.2",
		"@orpc/server": "^1.16.2",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.19",
		"slugify": "^1.6.9",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"better-sqlite3": "^13.2.0",
		"typescript": "^7.0.2"
	}
}
