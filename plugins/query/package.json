{
	"name": "@slotform/query",
	"version": "0.1.0",
	"description": "Query plugin for slotform: the api's procedures as TanStack Query reads and acts, and the port the UI's read hooks run on.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/slotform.git",
		"directory": "plugins/query"
	},
	"homepage": "https://github.com/fcalell/slotform/tree/master/plugins/query#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tanstack-query": "./src/tanstack-query.tsx",
		"./read": {
			"types": "./dist/read.d.ts",
			"default": "./dist/read.js"
		},
		"./acts": {
			"types": "./dist/acts.d.ts",
			"default": "./dist/acts.js"
		},
		"./scope": {
			"types": "./dist/scope.d.ts",
			"default": "./dist/scope.js"
		},
		"./ability-client": {
			"types": "./dist/ability-client.d.ts",
			"default": "./dist/ability-client.js"
		},
		"./listen": {
			"types": "./dist/listen.d.ts",
			"default": "./dist/listen.js"
		},
		"./preload": {
			"types": "./dist/preload.d.ts",
			"default": "./dist/preload.js"
		},
		"./net": "./src/ui/net.ts"
	},
	"files": [
		"dist",
		"src",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"test": "node --test 'src/**/*.test.ts'",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"dependencies": {
		"@slotform/cli": "workspace:^",
		"@slotform/api": "workspace:^",
		"@slotform/react": "workspace:^",
		"@slotform/vite": "workspace:^",
		"@slotform/ui-core": "workspace:^",
		"@orpc/client": "^1.16.2"
	},
	"peerDependencies": {
		"@casl/ability": "^7.1.3",
		"@orpc/tanstack-query": "^1.16.2",
		"@tanstack/react-query": "^5.107.1",
		"expo-network": "~58.0.5",
		"react": "^19.3.0",
		"react-native": "^0.88.0"
	},
	"peerDependenciesMeta": {
		"@orpc/tanstack-query": {
			"optional": true
		},
		"@tanstack/react-query": {
			"optional": true
		},
		"expo-network": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-native": {
			"optional": true
		}
	},
	"devDependencies": {
		"@casl/ability": "^7.1.3",
		"@slotform/typescript-config": "workspace:^",
		"@orpc/tanstack-query": "^1.16.2",
		"@tanstack/react-query": "^5.107.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"expo-network": "~58.0.5",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"typescript": "^7.0.2"
	}
}
