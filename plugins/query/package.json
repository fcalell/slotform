{
	"name": "@fcalell/plugin-query",
	"version": "0.1.0",
	"description": "Query plugin for @fcalell/stack: the api's procedures as TanStack Query reads and acts, and the port the UI's read hooks run on.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/query"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/query#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tanstack-query": "./src/tanstack-query.tsx",
		"./read": {
			"types": "./dist/read.d.ts",
			"default": "./dist/read.js"
		},
		"./acts": {
			"types": "./dist/acts.d.ts",
			"default": "./dist/acts.js"
		},
		"./scope": {
			"types": "./dist/scope.d.ts",
			"default": "./dist/scope.js"
		},
		"./ability-client": {
			"types": "./dist/ability-client.d.ts",
			"default": "./dist/ability-client.js"
		},
		"./listen": {
			"types": "./dist/listen.d.ts",
			"default": "./dist/listen.js"
		},
		"./preload": {
			"types": "./dist/preload.d.ts",
			"default": "./dist/preload.js"
		},
		"./net": "./src/ui/net.ts"
	},
	"files": [
		"dist",
		"src",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"test": "node --test 'src/**/*.test.ts'",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"dependencies": {
		"@casl/ability": "^7.1.3",
		"@fcalell/cli": "workspace:^",
		"@fcalell/plugin-api": "workspace:^",
		"@fcalell/plugin-react": "workspace:^",
		"@fcalell/plugin-vite": "workspace:^",
		"@fcalell/ui-core": "workspace:^",
		"@orpc/client": "^1.16.2"
	},
	"peerDependencies": {
		"@orpc/tanstack-query": "^1.16.2",
		"@tanstack/react-query": "^5.107.1",
		"expo-network": "~56.0.0",
		"react": "^19.2.0",
		"react-native": "^0.85.0"
	},
	"peerDependenciesMeta": {
		"@orpc/tanstack-query": {
			"optional": true
		},
		"@tanstack/react-query": {
			"optional": true
		},
		"expo-network": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-native": {
			"optional": true
		}
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"@orpc/tanstack-query": "^1.16.2",
		"@tanstack/react-query": "^5.107.1",
		"@types/node": "^25.5.0",
		"@types/react": "~19.2.16",
		"expo-network": "~56.0.0",
		"react": "19.2.3",
		"react-native": "^0.85.3",
		"typescript": "^5.9.3"
	}
}
