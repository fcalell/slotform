{
	"extends": "@slotform/typescript-config/node-tsx.json",
	"compilerOptions": {
		"types": [],
		"paths": {
			"virtual:slotform-procedure": ["./.slotform/procedure.ts"]
		},
		"composite": true,
		"incremental": true,
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declarationMap": true,
		"outDir": "./.slotform/types",
		"tsBuildInfoFile": "./.slotform/types/tsconfig.worker.tsbuildinfo"
	},
	"include": [
		"src/worker",
		".slotform/worker.ts",
		".slotform/procedure.ts",
		".slotform/worker-configuration.d.ts"
	]
}
