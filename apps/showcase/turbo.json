{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"generate": {
			"dependsOn": ["^build"],
			"outputs": [
				".slotform/**",
				"!.slotform/types/**",
				"!.slotform/node_modules/**",
				"stories/**"
			]
		},
		"check-types": {
			"dependsOn": ["^build", "generate"],
			"outputs": [".slotform/types/**"]
		}
	}
}
