{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"generate": {
			"dependsOn": ["^build"],
			"outputs": [
				".stack/**",
				"!.stack/types/**",
				"!.stack/node_modules/**",
				"stories/**"
			]
		},
		"check-types": {
			"dependsOn": ["^build", "generate"],
			"outputs": [".stack/types/**"]
		}
	}
}
