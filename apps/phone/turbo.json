{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"outputs": [
				".slotform/**",
				"!.slotform/types/**",
				"!.slotform/node_modules/**"
			]
		},
		"check-types": {
			"dependsOn": ["^build", "generate"],
			"outputs": [".slotform/types/**"]
		}
	}
}
